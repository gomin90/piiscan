{
  "version": 1,
  "description": "사용자 정의 ID 탐지 규칙. '%'는 임의 문자열 wildcard로 해석된다.",
  "custom_rules": [
    {
      "id": "sec_id",
      "label": ".sec로 끝나는 20자리 이하 ID",
      "suffix": ".sec",
      "max_len": 20,
      "charset": "alnum_-",
      "type": "CUSTOM_SEC_ID",
      "display_name": ".sec ID",
      "sensitivity": 0.6
    },
    {
      "id": "id_suffix",
      "label": ".id로 끝나는 20자리 이하 ID",
      "suffix": ".id",
      "max_len": 20,
      "charset": "alnum_-",
      "type": "CUSTOM_ID_SUFFIX",
      "display_name": ".id ID",
      "sensitivity": 0.55
    },
    {
      "id": "wildcard_dotted",
      "label": "%.%.% 형태의 20자리 이하 ID",
      "pattern": "%\\.%",
      "wildcard": true,
      "require_alpha": true,
      "max_len": 20,
      "charset": "alnum_-",
      "type": "CUSTOM_WILDCARD_ID",
      "display_name": "구분자 포함 ID",
      "sensitivity": 0.5,
      "exclude_suffixes": [
        ".co",
        ".com",
        ".csv",
        ".docx",
        ".edu",
        ".exe",
        ".gif",
        ".gov",
        ".htm",
        ".html",
        ".io",
        ".jp",
        ".jpeg",
        ".jpg",
        ".json",
        ".kr",
        ".log",
        ".mp4",
        ".net",
        ".org",
        ".pdf",
        ".png",
        ".txt",
        ".xls",
        ".xlsx",
        ".zip"
      ]
    },
    {
      "id": "member_id",
      "label": "member/customer 접두사 ID",
      "pattern": "(?:member|customer)[_-]?[A-Za-z0-9]{4,20}",
      "max_len": 24,
      "charset": "alnum_-",
      "type": "CUSTOM_IDENTIFIER",
      "display_name": "회원/고객 ID",
      "sensitivity": 0.6
    },
    {
      "id": "digits_alpha_digits",
      "label": "6digits+1alpha+4digits ID",
      "pattern": "\\d{6}[A-Za-z]\\d{4}",
      "max_len": 20,
      "charset": "alnum",
      "type": "CUSTOM_IDENTIFIER",
      "display_name": "복합 사용자 ID",
      "sensitivity": 0.6
    },
    {
      "id": "segmented_id",
      "label": "-로 구분된 4부분 ID",
      "pattern": "[A-Za-z0-9]{2,8}(?:-[A-Za-z0-9]{2,8}){3}",
      "max_len": 40,
      "charset": "alnum_-",
      "type": "CUSTOM_IDENTIFIER",
      "display_name": "구분자 포함 ID",
      "sensitivity": 0.55
    }
  ]
}
