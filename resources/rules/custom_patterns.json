{
  "version": 1,
  "description": "사용자 정의 ID 탐지 규칙. '%'는 임의 문자열 wildcard로 해석된다.",
  "custom_rules": [
    {
      "id": "sec_id",
      "label": ".sec로 끝나는 20자리 이하 ID",
      "suffix": ".sec",
      "max_len": 20,
      "charset": "alnum_-",
      "type": "CUSTOM_SEC_ID",
      "display_name": ".sec ID",
      "sensitivity": 0.6
    },
    {
      "id": "id_suffix",
      "label": ".id로 끝나는 20자리 이하 ID",
      "suffix": ".id",
      "max_len": 20,
      "charset": "alnum_-",
      "type": "CUSTOM_ID_SUFFIX",
      "display_name": ".id ID",
      "sensitivity": 0.55
    },
    {
      "id": "wildcard_dotted",
      "label": "%.%.% 형태의 20자리 이하 ID",
      "pattern": "%\\.%",
      "wildcard": true,
      "require_alpha": true,
      "max_len": 20,
      "charset": "alnum_-",
      "type": "CUSTOM_WILDCARD_ID",
      "display_name": "구분자 포함 ID",
      "sensitivity": 0.5
    }
  ]
}
